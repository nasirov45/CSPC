rule all:
    input:
        "results/report.txt"

rule analyse:
    input:
        "data/seismogram_A.csv",
        "data/seismogram_B.csv",
        "analyse.py"
    output:
        "results/events.csv"
    shell:
        "python analyse.py"

rule report:
    input:
        "results/events.csv",
        "report.py"
    output:
        "results/report.txt"
    shell:
        "python report.py"